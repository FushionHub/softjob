# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))")
JWT_SECRET=your_jwt_secret_here

# Neon Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# SMTP Configuration (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# Admin Email (receives all admin alerts + KYC notifications)
ADMIN_EMAIL=jmauricennadi@gmail.com

# Admin JWT Secret (can be same as JWT_SECRET)
ADMIN_JWT_SECRET=your_jwt_secret_here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Wallet Encryption Key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
WALLET_ENCRYPTION_KEY=your_64_char_hex_string_here

# Bachs.io (https://bachs.io) - Card + Crypto checkout (inline/hosted)
# Create at https://app.bachs.io -> Developer. Use sandbox first: sk_sandbox_ + https://sandbox-api.bachs.io
BACHS_API_KEY=sk_sandbox_your_key_here
BACHS_API_BASE=https://api.bachs.io
BACHS_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google OAuth (One-tap, backend-verified, onboarding with skip)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Get at https://console.cloud.google.com -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:3000 , https://yourdomain.com
# Authorized redirect URIs: http://localhost:3000/api/auth/google (if using code flow) — for GIS id_token no redirect needed
# No demo: requires real Google Cloud project and consent screen

# KYC System (real-time verification, no demo)
KYC_ENABLED=true
KYC_LOCK_EDIT_AFTER_VERIFIED=true  # true = locks edit after approved (toggle via .env)
KYC_REQUIRE_FOR_WITHDRAW=false
KYC_ADMIN_NOTIFY=true
KYC_AUTO_APPROVE=true
KYC_AUTO_APPROVE_DELAY=15  # seconds until pending auto-verified in real-time (false = manual admin only via POST /api/kyc/review)
