# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))")
JWT_SECRET=your_jwt_secret_here

# Database — PostgreSQL (Neon Cloud) or MySQL (cPanel Shared Hosting)
# PostgreSQL: DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# MySQL:      DATABASE_URL=mysql://username:password@127.0.0.1:3306/dbname
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# SMTP Configuration (Transactional & KYC Alerts)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_secure_password
SMTP_FROM=noreply@yourdomain.com

# Admin Email (receives all platform & KYC notifications)
ADMIN_EMAIL=admin@yourdomain.com

# Admin JWT Secret (can be same as JWT_SECRET)
ADMIN_JWT_SECRET=your_jwt_secret_here

# Application URL
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Platform Brand & Support
SITE_NAME=Emporium Capitals
SITE_TAGLINE=Institutional Algorithmic Liquidity & Crypto Portfolios
SUPPORT_EMAIL=support@yourdomain.com

# Default Primary Investor Profile
DEFAULT_USER_EMAIL=investor@yourdomain.com
DEFAULT_USER_NAME=Default Investor
DEFAULT_USER_USERNAME=Investor
DEFAULT_USER_PHONE=+1234567890

# Official Deposit Wallet Addresses
USDT_DEPOSIT_ADDRESS=T9yD14Nj9j7xAB4dbGeiX9h8unkKHxuWwb
BTC_DEPOSIT_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
ETH_DEPOSIT_ADDRESS=0x71C836eB3F3d44F6bF0Fe331d279148d4b3bEAc2

# Financial Thresholds & Fee Structure
MIN_DEPOSIT=50.00
MAX_DEPOSIT=500000.00
MIN_WITHDRAWAL=50.00
MAX_WITHDRAWAL=100000.00
WITHDRAWAL_FEE=2.00
SWAP_FEE=0.50

# 3-Tier Multi-Level Affiliate Commission Rates (%)
REFERRAL_BONUS_TIER1=5.00
REFERRAL_BONUS_TIER2=2.00
REFERRAL_BONUS_TIER3=1.00

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Wallet Encryption Key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
WALLET_ENCRYPTION_KEY=your_64_char_hex_string_here

# Bachs.io (https://bachs.io) - Card + Crypto checkout (inline/hosted)
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_API_BASE=https://api.bachs.io

# KYC System (Real-time verification)
KYC_ENABLED=true
KYC_LOCK_EDIT_AFTER_VERIFIED=true
KYC_REQUIRE_FOR_WITHDRAW=false
KYC_ADMIN_NOTIFY=true
KYC_AUTO_APPROVE=true
KYC_AUTO_APPROVE_DELAY=15

# cPanel Administrative Suite Access Tokens
CPANEL_SETUP_TOKEN=generate-a-64-character-hex-token
CPANEL_MANAGER_TOKEN=generate-a-64-character-hex-token
CPANEL_MAILTEST_TOKEN=generate-a-64-character-hex-token

# Process & Port Configuration
PORT=3000
NODE_ENV=production
