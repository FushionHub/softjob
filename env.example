# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))")
JWT_SECRET=your_jwt_secret_here

# Neon Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/softjob?sslmode=disable

# SMTP Configuration (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# Admin Email & Seed Password (ADMIN_INITIAL_PASSWORD required for initial seed)
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change_this_secure_password_123!

# Admin JWT Secret (can be same as JWT_SECRET)
ADMIN_JWT_SECRET=your_jwt_secret_here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Wallet Encryption Key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
WALLET_ENCRYPTION_KEY=your_64_char_hex_string_here

# Bachs.io (https://bachs.io) - Card + Crypto checkout (inline/hosted)
BACHS_API_KEY=sk_sandbox_your_key_here
BACHS_API_BASE=https://api.bachs.io
BACHS_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# KYC System
KYC_ENABLED=true
KYC_LOCK_EDIT_AFTER_VERIFIED=true
KYC_REQUIRE_FOR_WITHDRAW=false
KYC_ADMIN_NOTIFY=true
KYC_AUTO_APPROVE=true
KYC_AUTO_APPROVE_DELAY=15
