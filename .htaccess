# ==============================================================================
# Emporium Capitals — cPanel Apache Reverse Proxy for PM2 / Node.js
# ==============================================================================
# Application runs via PM2 on port 3000:
# pm2 start ecosystem.config.js
# ==============================================================================

Options -Indexes
DirectoryIndex index.html index.php

# ------------------------------------------------------------------------------
# 1. Security Denials: Secrets, Source Code & Hidden Files
# ------------------------------------------------------------------------------
# Block dotfiles (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block sensitive project files, database dumps, and server configs
<FilesMatch "^(\.env.*|\.user\.ini|php\.ini|package(-lock)?\.json|bun\.lock|.*\.sql|.*\.log|server\.js|proxy\.js|next\.config\.mjs|ecosystem\.config\.js)$">
    Require all denied
</FilesMatch>

# Block direct URL access to internal directories (allow public & .next/static)
RedirectMatch 404 ^/(node_modules|\.git|app|lib|components|sections|scripts|coverage|\.vscode)(/|$)
RedirectMatch 404 ^/\.next/(server|cache|types|BUILD_ID|export-marker\.json)(/|$)

# ------------------------------------------------------------------------------
# 2. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------------------
# 3. Compression (Gzip & Brotli)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json font/woff font/woff2 image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json font/woff font/woff2 image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 4. Direct Static Asset Offloading & High-Performance Caching
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 5. Universal Routing & LiteSpeed / Apache cPanel Compatibility
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Direct access to cPanel setup & administration suite
    RewriteCond %{REQUEST_URI} ^/(cpanelsetup|cpanel)(/|$) [NC]
    RewriteRule ^ - [L]

    # 2. Directly serve public directory assets (favicons, logos, icons)
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 3. Directly serve existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Primary root startup file (universal index.html using CDN packages)
    RewriteRule ^$ index.html [L]

    # 5. SPA Client-Side Routing Fallback to index.html (Works on LiteSpeed, Apache, Nginx)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(cpanelsetup|cpanel) [NC]
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

<IfModule mod_proxy.c>
    # Optional reverse proxy header handling
    ProxyPassReverse / http://127.0.0.1:3000/
</IfModule>
