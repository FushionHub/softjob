# ==============================================================================
# Emporium Capitals — cPanel Shared Hosting Configuration (PM2 / Node.js)
# ==============================================================================
# Designed for PM2 execution on cPanel terminal:
# `pm2 start ecosystem.config.js`
# ==============================================================================

Options -Indexes

# ------------------------------------------------------------------------------
# 1. Security Denials: Secrets, Source Code & Hidden Files
# ------------------------------------------------------------------------------
# Block dotfiles (.env, .git, .nvmrc, .user.ini, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block sensitive project files, database dumps, and server configs
<FilesMatch "^(\.env.*|\.user\.ini|php\.ini|package(-lock)?\.json|bun\.lock|.*\.sql|.*\.log|server\.js|proxy\.js|next\.config\.mjs|ecosystem\.config\.js)$">
    Require all denied
</FilesMatch>

# Block direct URL access to internal directories (allow public & .next/static)
RedirectMatch 404 ^/(node_modules|\.git|app|lib|components|sections|scripts|coverage|\.vscode)(/|$)
RedirectMatch 404 ^/\.next/(server|cache|types|BUILD_ID|export-marker\.json)(/|$)

# ------------------------------------------------------------------------------
# 2. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------------------
# 3. Compression (Gzip & Brotli)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json font/woff font/woff2 image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json font/woff font/woff2 image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 4. Direct Static Asset Offloading & High-Performance Caching
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# 5. Routing & Reverse Proxy to PM2 Node.js (Port 3000)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Optional HTTPS Enforcement (Uncomment if SSL is active)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Direct access to cPanel management and diagnostic scripts
    RewriteCond %{REQUEST_URI} ^/cpanel/ [NC]
    RewriteRule ^ - [L]

    # Directly serve Next.js static build chunks (_next/static/* -> .next/static/*)
    RewriteCond %{DOCUMENT_ROOT}/.next/static/$1 -f
    RewriteRule ^_next/static/(.*)$ .next/static/$1 [L]

    # Directly serve public directory assets (favicons, public images, icons)
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Primary: Apache mod_proxy reverse-proxy directly to PM2 running on port 3000
    <IfModule mod_proxy.c>
        RewriteRule ^$ http://127.0.0.1:3000/ [P,L]
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
        ProxyPassReverse / http://127.0.0.1:3000/
    </IfModule>

    # Fallback: If Apache mod_proxy is not enabled, proxy via index.php
    <IfModule !mod_proxy.c>
        RewriteRule ^$ index.php [L,QSA]
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteRule ^(.*)$ index.php [L,QSA]
    </IfModule>
</IfModule>
