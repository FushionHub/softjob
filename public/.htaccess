# ==============================================================================
# Emporium Capitals — Static Asset Optimization for cPanel / Apache / LiteSpeed
# ==============================================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css application/javascript application/json image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/css application/javascript application/json image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(woff|woff2|ttf|eot|svg|png|jpg|jpeg|webp|ico|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
